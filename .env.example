# Base URL of the backend API (used by src/api/client.js).
# Leave unset to use the default "/api" (e.g. behind a dev proxy or same-origin deploy).
# VITE_API_BASE_URL=http://localhost:5000/api

# Unset or "true": a fake backend (src/mocks) answers API requests in the browser.
# "false": talk to the real backend at VITE_API_BASE_URL.
VITE_USE_MOCK=true
